# Server port
PORT=3000

# Session secret — change this to a long random string in production
SESSION_SECRET=change-me-to-something-long-and-random

# Admin account password (plain text here; the seed script hashes it with bcryptjs)
ADMIN_PASSWORD=admin123

# Node environment
NODE_ENV=development

# Allowed origin for Socket.IO CORS (set to your public domain in production)
# Example: CLIENT_ORIGIN=https://scoreboard.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173
