{
  "name": "petrobowl-scoreboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "seed": "node server/src/db/seed.js",
    "migrate": "node server/src/db/migrate.js",
    "start": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
